<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="Panel">
        <item name="android:background">@drawable/panel_bg</item>
        <item name="android:padding">24dp</item>
    </style>

    <style name="PanelTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SmallButton">
        <item name="android:textSize">19sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:background">@drawable/button_bg</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="BarButton">
        <item name="android:textSize">22sp</item>
        <item name="android:minHeight">80dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:background">@drawable/button_bg</item>
    </style>
</resources>
